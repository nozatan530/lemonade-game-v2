{
  "rules": {
    "gmAllow": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "gmGames": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
        ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous' && root.child('gmAllow').child(auth.uid).val() === true"
      }
    },
    "games": {
      "$code": {
        ".write": "auth != null && data.child('meta/gmUid').val() === auth.uid && !newData.exists()",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && newData.child('gmUid').val() === auth.uid && (data.exists() ? data.child('gmUid').val() === auth.uid : root.child('gmAllow').child(auth.uid).val() === true)",
          ".validate": "newData.hasChildren(['gmUid', 'createdAt', 'status'])"
        },
        "config": {
          ".read": "auth != null && root.child('games').child($code).child('meta/gmUid').val() === auth.uid",
          ".write": "auth != null && root.child('games').child($code).child('meta/gmUid').val() === auth.uid"
        },
        "public": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('games').child($code).child('meta/gmUid').val() === auth.uid"
        },
        "settings": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('games').child($code).child('meta/gmUid').val() === auth.uid"
        },
        "clock": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('games').child($code).child('meta/gmUid').val() === auth.uid"
        },
        "state": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('games').child($code).child('meta/gmUid').val() === auth.uid"
        },
        "hidden": {
          ".read": "auth != null && root.child('games').child($code).child('meta/gmUid').val() === auth.uid",
          ".write": "auth != null && root.child('games').child($code).child('meta/gmUid').val() === auth.uid"
        },
        "decided": {
          ".read": "auth != null && root.child('games').child($code).child('meta/gmUid').val() === auth.uid",
          ".write": "auth != null && root.child('games').child($code).child('meta/gmUid').val() === auth.uid"
        },
        "results": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('games').child($code).child('meta/gmUid').val() === auth.uid && !newData.exists()",
          "$m": {
            ".write": "auth != null && root.child('games').child($code).child('meta/gmUid').val() === auth.uid && !data.exists()"
          }
        },
        "teams": {
          ".read": "auth != null",
          "$teamId": {
            "name": {
              ".write": "auth != null && root.child('games').child($code).child('meta/gmUid').val() === auth.uid"
            },
            "order": {
              ".write": "auth != null && root.child('games').child($code).child('meta/gmUid').val() === auth.uid"
            },
            "uid": {
              ".write": "auth != null && (root.child('games').child($code).child('meta/gmUid').val() === auth.uid || (root.child('games').child($code).child('teams').child($teamId).child('name').exists() && (!data.exists() || data.val() === auth.uid) && newData.val() === auth.uid))"
            }
          }
        },
        "submitted": {
          ".read": "auth != null",
          "$m": {
            "$teamId": {
              ".write": "auth != null && root.child('games').child($code).child('teams').child($teamId).child('uid').val() === auth.uid && root.child('games').child($code).child('clock/phase').val() === 'input' && root.child('games').child($code).child('clock/monthKey').val() === $m && now <= root.child('games').child($code).child('clock/deadlineAt').val() + 3000",
              ".validate": "newData.val() === true"
            }
          }
        },
        "subs": {
          ".write": "auth != null && root.child('games').child($code).child('meta/gmUid').val() === auth.uid && !newData.exists()",
          "$m": {
            ".read": "auth != null && root.child('games').child($code).child('meta/gmUid').val() === auth.uid",
            "$teamId": {
              ".read": "auth != null && root.child('games').child($code).child('teams').child($teamId).child('uid').val() === auth.uid",
              ".write": "auth != null && root.child('games').child($code).child('teams').child($teamId).child('uid').val() === auth.uid && root.child('games').child($code).child('clock/phase').val() === 'input' && root.child('games').child($code).child('clock/monthKey').val() === $m && now <= root.child('games').child($code).child('clock/deadlineAt').val() + 3000",
              ".validate": "newData.hasChildren(['monthlyDecision', 'submittedAt'])",
              "submittedAt": {
                ".validate": "newData.val() === now"
              },
              "monthlyDecision": {
                ".validate": "newData.hasChildren(['lemonQty', 'sugarQty', 'price'])",
                "lemonQty": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
                },
                "sugarQty": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
                },
                "price": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
                },
                "maxSell": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
                },
                "watching": {
                  ".validate": "newData.isBoolean()"
                },
                "$other": {
                  ".validate": false
                }
              },
              "quarterlyDecision": {
                ".validate": "newData.hasChildren(['baristaCount']) && root.child('games').child($code).child('clock/quarterStart').val() === true",
                "baristaCount": {
                  ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50"
                },
                "$other": {
                  ".validate": false
                }
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      }
    },
    "roomIndex": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null && ((!data.exists() && newData.val() === now) || (!newData.exists() && data.val() < now - 21600000))"
      }
    },
    "roomOwners": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && newData.exists() && (!data.exists() || !root.child('roomIndex').child(data.val()).exists() || root.child('roomIndex').child(data.val()).val() < now - 21600000 || root.child('rooms').child(data.val()).child('meta/status').val() === 'ended')"
      }
    },
    "rooms": {
      "$code": {
        ".write": "auth != null && !newData.exists() && root.child('roomIndex').child($code).val() < now - 21600000",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists() && newData.child('ownerUid').val() === auth.uid && newData.parent().parent().parent().child('roomOwners').child(auth.uid).val() === $code && newData.parent().parent().parent().child('roomIndex').child($code).exists()",
          ".validate": "newData.hasChildren(['ownerUid', 'createdAt', 'status', 'difficulty'])",
          "status": {
            ".write": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists()"
          }
        },
        "config": {
          ".read": "auth != null",
          ".write": "auth != null && !root.child('rooms').child($code).child('meta').exists() && newData.parent().child('meta/ownerUid').val() === auth.uid"
        },
        "public": {
          ".read": "auth != null",
          ".write": "auth != null && !root.child('rooms').child($code).child('meta').exists() && newData.parent().child('meta/ownerUid').val() === auth.uid"
        },
        "clock": {
          ".read": "auth != null",
          ".write": "auth != null && (!root.child('rooms').child($code).child('meta').exists() && newData.parent().child('meta/ownerUid').val() === auth.uid || root.child('rooms').child($code).child('members').child(auth.uid).exists())"
        },
        "state": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists()"
        },
        "decided": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists()"
        },
        "results": {
          ".read": "auth != null",
          "$m": {
            ".write": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists() && !data.exists()"
          }
        },
        "seats": {
          ".read": "auth != null",
          ".write": "auth != null && !root.child('rooms').child($code).child('meta').exists() && newData.parent().child('meta/ownerUid').val() === auth.uid",
          "$t": {
            "uid": {
              ".write": "auth != null && newData.val() === auth.uid && !root.child('rooms').child($code).child('members').child(auth.uid).exists() && !data.parent().child('robot').exists() && ((!data.exists() && root.child('rooms').child($code).child('clock/phase').val() === 'lobby') || (data.exists() && data.parent().child('online').val() !== true && root.child('rooms').child($code).child('clock/phase').val() !== 'lobby' && root.child('rooms').child($code).child('clock/phase').val() !== 'final'))"
            },
            "robot": {
              ".write": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists() && !data.exists()"
            },
            "online": {
              ".write": "auth != null && root.child('rooms').child($code).child('seats').child($t).child('uid').val() === auth.uid",
              ".validate": "newData.isBoolean()"
            }
          }
        },
        "members": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.isString() && ((!root.child('rooms').child($code).child('meta').exists() && newData.parent().parent().child('meta/ownerUid').val() === auth.uid) || newData.parent().parent().child('seats').child(newData.val()).child('uid').val() === auth.uid)"
          }
        },
        "subs": {
          "$m": {
            "$t": {
              ".read": "auth != null && (root.child('rooms').child($code).child('seats').child($t).child('uid').val() === auth.uid || (root.child('rooms').child($code).child('members').child(auth.uid).exists() && root.child('rooms').child($code).child('clock/phase').val() !== 'input'))",
              ".write": "auth != null && root.child('rooms').child($code).child('seats').child($t).child('uid').val() === auth.uid && root.child('rooms').child($code).child('clock/phase').val() === 'input' && root.child('rooms').child($code).child('clock/monthKey').val() === $m && now <= root.child('rooms').child($code).child('clock/deadlineAt').val() + 3000",
              ".validate": "newData.hasChildren(['monthlyDecision', 'submittedAt'])",
              "submittedAt": {
                ".validate": "newData.val() === now"
              },
              "monthlyDecision": {
                ".validate": "newData.hasChildren(['lemonQty', 'sugarQty', 'price'])",
                "lemonQty": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
                },
                "sugarQty": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
                },
                "price": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
                },
                "maxSell": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
                },
                "watching": {
                  ".validate": "newData.isBoolean()"
                },
                "$other": {
                  ".validate": false
                }
              },
              "quarterlyDecision": {
                ".validate": "newData.hasChildren(['baristaCount']) && root.child('rooms').child($code).child('clock/quarterStart').val() === true",
                "baristaCount": {
                  ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50"
                },
                "$other": {
                  ".validate": false
                }
              },
              "$other": {
                ".validate": false
              }
            },
            ".read": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists() && root.child('rooms').child($code).child('clock/phase').val() !== 'input'"
          }
        },
        "submitted": {
          ".read": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists()",
          "$m": {
            "$t": {
              ".write": "auth != null && root.child('rooms').child($code).child('seats').child($t).child('uid').val() === auth.uid && root.child('rooms').child($code).child('clock/phase').val() === 'input'",
              ".validate": "newData.val() === now"
            }
          }
        },
        "ready": {
          ".read": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists()",
          "$m": {
            "$t": {
              ".write": "auth != null && root.child('rooms').child($code).child('seats').child($t).child('uid').val() === auth.uid",
              ".validate": "newData.isBoolean()"
            }
          }
        },
        "auto": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists()"
        }
      }
    }
  }
}
